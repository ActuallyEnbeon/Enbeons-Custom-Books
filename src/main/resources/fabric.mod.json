{
  "schemaVersion": 1,
  "id": "enbeons_custom_books",
  "version": "${version}+${mc_title}",
  "name": "${name}",
  "description": "Yet another mod that gives Enchanted Books unique textures based on the enchantments they have. Highly customisible.",
  "authors": [
    "Enbeon"
  ],
  "contributors": [
    "moqyng"
  ],
  "contact": {
    "homepage": "https://modrinth.com/mod/enbeons-custom-books",
    "issues": "https://github.com/ActuallyEnbeon/Enbeons-Custom-Books/issues",
    "sources": "https://github.com/ActuallyEnbeon/Enbeons-Custom-Books"
  },
  "custom": {
    "modmenu": {
      "links": {
        "modmenu.buymeacoffee": "https://buymeacoffee.com/actuallyenbeon"
      }
    }
  },
  "license": "LGPL-3.0-or-later",
  "icon": "assets/enbeons_custom_books/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.enbeon.books.EnbeonsCustomBooks"
    ],
    "modmenu": [
      "com.enbeon.books.config.BooksModMenuIntegration"
    ]
  },
  "mixins": [
    {
      "config": "enbeons_custom_books.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.18",
    "minecraft": "${minecraft}",
    "java": ">=21",
    "${fabric_api_id}": "*"
  },
  "recommends": {
    "yet_another_config_lib_v3": ">=${yacl}",
    "modmenu": ">=${modmenu}"
  }
}
